  "statGrow": "atkPercent",
  "constellations": [
    {
      "name": "The Cadence of Suppressive Fire",
      "description": "Valeriy regenerates 6 Elemental Energy after performing the special Charged Attack <span style=\"color: #FFD780FF;\"><button data-link=\"11370001\">Direct-Fire Mortar: Point-Blank Bombardment</button></span>. For every 10 <span style=\"color: #FFD780FF;\"><button data-link=\"11370003\">Impact Momentum</button></span> consumed beyond 40 when performing this special Charged Attack, he regenerates an additional 1.5 Elemental Energy. Each time he performs <span style=\"color: #FFD780FF;\">Direct-Fire Mortar: Point-Blank Bombardment</span>, he can regenerate up to 15 Elemental Energy in this way. This effect can trigger once every 15s.\nAdditionally, each time Valeriy enters combat, the first time he uses his Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link-s=\"Active Defense: Bastion Charge\">Active Defense: Bastion Charge</button></span>, he gains an additional amount of <span style=\"color: #FFD780FF;\">Impact Momentum</span> equal to 150% of the amount normally gained."
    },
    {
      "name": "Ranks That Charge as One",
      "description": "All nearby party members gain 100 Elemental Mastery for 18s after Valeriy uses his Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link-s=\"Active Defense: Bastion Charge\">Active Defense: Bastion Charge</button></span>.\nAdditionally, while protected by a Supercharged Shield, if Valeriy is already at maximum <span style=\"color: #FFD780FF;\"><button data-link=\"11370003\">Impact Momentum</button></span>, any further <span style=\"color: #FFD780FF;\">Impact Momentum</span> he would gain is instead converted into increased DMG Absorption for the shield. Each point of excess <span style=\"color: #FFD780FF;\">Impact Momentum</span> increases the Supercharged Shield's DMG Absorption by an amount equal to 8% of Valeriy's ATK. Up to 20 excess <span style=\"color: #FFD780FF;\">Impact Momentum</span> can be converted in this way."
    },
    {
      "name": "Vigilance at Close Quarters",
      "description": "Increases the Level of Normal Attack <span style=\"color: #FFD780FF;\"><button data-link-s=\"Guard Tactics: Sword and Shield\">Guard Tactics: Sword and Shield</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "Fortitude Unshaken by Attrition",
      "description": "<span style=\"color: #FFD780FF;\"><button data-link=\"11370003\">Impact Momentum</button></span>'s limit is increased by 30, and its charging efficiency is increased by 30%.\nAdditionally, the Ascension Talent <span style=\"color: #FFD780FF;\"><button data-link-p=\"Advance With the Creeping Barrage\">Advance With the Creeping Barrage</button></span> is enhanced: The maximum amount of <span style=\"color: #FFD780FF;\">Impact Momentum</span> that can be gained from this Talent after using the Elemental Burst is 104. You must unlock the Ascension Talent <span style=\"color: #FFD780FF;\">Advance With the Creeping Barrage</span> to gain access to this effect."
    },
    {
      "name": "Resolve to Divide and Destroy",
      "description": "Increases the Level of the Elemental Skill <span style=\"color: #FFD780FF;\"><button data-link-s=\"Active Defense: Bastion Charge\">Active Defense: Bastion Charge</button></span> by 3.\nMaximum upgrade level is 15."
    },
    {
      "name": "The Strength to Breach Enemy Lines",
      "description": "The special Charged Attack <span style=\"color: #FFD780FF;\"><button data-link=\"11370001\">Direct-Fire Mortar: Point-Blank Bombardment</button></span> and <span style=\"color: #FFD780FF;\">Thunderburst Shells</span> from Elemental Burst <span style=\"color: #FFD780FF;\"><button data-link-s=\"Focused Fire: Lightning Salvo\">Focused Fire: Lightning Salvo</button></span> are enhanced: Their DMG is increased by 100%, and opponents they hit have the CRIT Rate of <span style=\"color: #FFACFFFF;\">Electro DMG</span> they take increased by 10% for 7s. If the <span style=\"color: #FFACFFFF;\">Electro DMG</span> taken is Stellar-Conduct reaction DMG, that DMG instance's CRIT DMG is also increased by 40%."
    }
  ],
  "passives": [
    {
      "name": "Advance With the Creeping Barrage",
      "description": "Valeriy gains 5 <span style=\"color: #FFD780FF;\"><button data-link=\"11370003\">Impact Momentum</button></span> whenever another nearby active character in the party hits an opponent with an <span style=\"color: #FFACFFFF;\">Electro</span> attack while the <span style=\"color: #FFD780FF;\">Thunderburst Shells</span> from his Elemental Burst <span style=\"color: #FFD780FF;\"><button data-link-s=\"Focused Fire: Lightning Salvo\">Focused Fire: Lightning Salvo</button></span> are falling. He can gain up to 80 <span style=\"color: #FFD780FF;\">Impact Momentum</span> in this way after each use of his Elemental Burst."
    },
    {
      "name": "Into the Breach",
      "description": "<span style=\"color: #FFD780FF;\"><button data-link=\"11370002\">Offensive Directive</button></span> is enhanced based on the amount of <span style=\"color: #FFD780FF;\"><button data-link=\"11370003\">Impact Momentum</button></span> consumed when performing his special Charged Attack <span style=\"color: #FFD780FF;\"><button data-link=\"11370001\">Direct-Fire Mortar: Point-Blank Bombardment</button></span>. Each point consumed further increases the DMG Bonus granted by <span style=\"color: #FFD780FF;\">Offensive Directive</span>. If Valeriy is:\n·In the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state: Each point of <span style=\"color: #FFD780FF;\">Impact Momentum</span> consumed increases this DMG Bonus by an amount equal to 0.9% of Valeriy's ATK;\n·Not in the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state: Each point of <span style=\"color: #FFD780FF;\">Impact Momentum</span> consumed increases this DMG Bonus by an amount equal to 0.3% of Valeriy's ATK."
    },
    {
      "name": "Subzero Conditioning",
      "description": "Valeriy enters the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state while within a <button data-link=\"11330003\"><span style=\"color: #FFD780FF;\">Polestar Field</span></button>."
    },
    {
      "name": "Tundra Operational Intelligence",
      "description": "Gains 25% more rewards when dispatched on a Snezhnaya (not including Nod-Krai) Expedition for 20 hours."
    }
  ],
  "links": {
    "11330003": {
      "title": "Polestar Field",
      "desc": "When Stellar-Conduct is triggered, the surrounding area will transform into a <span style=\"color: #FFD780FF;\">Polestar Field</span> for a short period of time, and when inside a Polestar Field, certain characters will enter the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state, which grants various skill buffs."
    },
    "11370001": {
      "title": "Direct-Fire Mortar: Point-Blank Bombardment",
      "desc": "Valeriy's special Charged Attack. Using a Charged Attack while he has at least 40 <span style=\"color: #FFD780FF;\">Impact Momentum</span> consumes all <span style=\"color: #FFD780FF;\">Impact Momentum</span> to unleash this special Charged Attack instead, dealing <span style=\"color: #FFACFFFF;\">AoE Electro DMG</span> in front of him and granting 15 stacks of <span style=\"color: #FFD780FF;\">Offensive Directive</span>.\nWhen this special Charged Attack is used again, the <span style=\"color: #FFD780FF;\">Offensive Directive</span> stack count will be refreshed.\nWithin 0.8s after using the Elemental Skill <span style=\"color: #FFD780FF;\">Active Defense: Bastion Charge</span> or the Elemental Burst <span style=\"color: #FFD780FF;\">Focused Fire: Lightning Salvo</span>, if Valeriy has at least 40 <span style=\"color: #FFD780FF;\">Impact Momentum</span>, the next Normal Attack he uses will be converted to the special Charged Attack <span style=\"color: #FFD780FF;\">Direct-Fire Mortar: Point-Blank Bombardment</span>."
    },
    "11370002": {
      "title": "Offensive Directive",
      "desc": "A special effect Valeriy gains after performing the special Charged Attack <span style=\"color: #FFD780FF;\">Direct-Fire Mortar: Point-Blank Bombardment</span>. It increases different types of <span style=\"color: #FFACFFFF;\">Electro DMG</span> depending on whether Valeriy is in the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state. If Valeriy is:\n·In the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state: When a nearby active character in the party deals <span style=\"color: #FFACFFFF;\">Electro DMG</span> considered Stellar-Conduct reaction DMG to an opponent with a Normal Attack, Charged Attack, Plunging Attack, Elemental Skill, or Elemental Burst, 1 stack of <span style=\"color: #FFD780FF;\">Offensive Directive</span> is consumed to increase that DMG, with the increase based on Valeriy's ATK;\n·Not in the <span style=\"color: #FFD780FF;\">Radiance: Stellar-Conduct</span> state: When a nearby active character in the party deals <span style=\"color: #FFACFFFF;\">Electro DMG</span> to an opponent with a Normal Attack, Charged Attack, Plunging Attack, Elemental Skill, or Elemental Burst, 1 stack of <span style=\"color: #FFD780FF;\">Offensive Directive</span> is consumed to increase that DMG, with the increase based on Valeriy's ATK.\nWhen a single instance of <span style=\"color: #FFACFFFF;\">Electro DMG</span> hits multiple opponents simultaneously, <span style=\"color: #FFD780FF;\">Offensive Directive</span> stacks are consumed based on the number of opponents hit."
    },
    "11370003": {
      "title": "Impact Momentum",
      "desc": "A special energy Valeriy uses to enhance his combat capabilities. Its initial maximum is 100. When he has at least 40 <span style=\"color: #FFD780FF;\">Impact Momentum</span>, he can perform the special Charged Attack <span style=\"color: #FFD780FF;\">Direct-Fire Mortar: Point-Blank Bombardment</span>.\nValeriy can gain <span style=\"color: #FFD780FF;\">Impact Momentum</span> in the following ways:\n·By using his Elemental Skill <span style=\"color: #FFD780FF;\">Active Defense: Bastion Charge</span>;\n·After unlocking the Ascension Talent \"Advance With the Creeping Barrage,\" while his Elemental Burst <span style=\"color: #FFD780FF;\">Focused Fire: Lightning Salvo</span> is active, when a nearby active character in the party hits an opponent with an <span style=\"color: #FFACFFFF;\">Electro</span> attack."
    }
  },
  "burst": {
    "name": "Focused Fire: Lightning Salvo",
    "description": "Deals <span style=\"color: #FFACFFFF;\">AoE Electro DMG</span> to nearby opponents and fires a <span style=\"color: #FFD780FF;\">Thunderburst Shell</span> high into the air. The <span style=\"color: #FFD780FF;\">Thunderburst Shell</span> disperses into a barrage of projectiles that rain down, dealing <span style=\"color: #FFACFFFF;\">AoE Electro DMG</span> to nearby opponents.\n\n<i>\"Steel your resolve, take the field in heavy armor, and bring death thundering down upon the enemy.\"</i>",
